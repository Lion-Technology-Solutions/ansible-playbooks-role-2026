# Vercel Marketplace provisions DATABASE_URL. Use a separate development Postgres database locally.
DATABASE_URL=
SCHOOL_SECRET_KEY=
SCHOOL_ADMIN_PASSWORD=
# Optional: private seed recording link, never commit it to this repository.
INITIAL_ANALYTICS_RECORDING_URL=

# Global enrollment fee card checkout (server-only; never NEXT_PUBLIC/PUBLIC).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Zoom Server-to-Server OAuth account credentials and licensed host user ID/email.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=
# Sender must be verified in SendGrid before delivery is available.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=liontechacademy@gmail.com
